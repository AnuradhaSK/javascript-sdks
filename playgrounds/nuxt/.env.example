# Base URL of your ThunderID server.
NUXT_PUBLIC_THUNDERID_BASE_URL=https://localhost:8090

# Client ID of the application registered in ThunderID. Needed for the redirect sign-in flow
# (GET /api/auth/signin). Register http://localhost:3002/api/auth/callback as its redirect URI.
NUXT_PUBLIC_THUNDERID_CLIENT_ID=

# Optional: client secret, for a confidential client. Server-only, never sent to the browser.
THUNDERID_CLIENT_SECRET=

# Optional: ID of the same application. Needed for the app-native (embedded) sign-in and sign-up
# flows rendered by <SignIn /> and <SignUp />, and for the flow metadata of this application.
NUXT_PUBLIC_THUNDERID_APPLICATION_ID=

# Flow Secret of the application, sent when an app-native flow starts. Server-only.
THUNDERID_FLOW_SECRET=

# Secret that signs the session cookie. Generate one locally, for example with
# `openssl rand -base64 32`. Unset uses an insecure development default.
THUNDERID_SESSION_SECRET=

# Where the browser goes after sign-in and sign-out.
NUXT_PUBLIC_THUNDERID_AFTER_SIGN_IN_URL=/
NUXT_PUBLIC_THUNDERID_AFTER_SIGN_OUT_URL=/

# DANGER: turns off TLS verification for every request the Nuxt server makes. Only for a local
# ThunderID server with a self-signed certificate. Never use it in production.
NODE_TLS_REJECT_UNAUTHORIZED=0
