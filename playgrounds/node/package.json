{
  "name": "@thunderid/playground-node",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Playground for exercising every @thunderid/node client operation, with an operations explorer UI.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.ts,.cjs,.mjs",
    "lint:fix": "eslint . --fix --ext .js,.ts,.cjs,.mjs",
    "format:check": "prettier --check --cache .",
    "format:fix": "prettier --write --cache ."
  },
  "dependencies": {
    "@thunderid/node": "workspace:*"
  },
  "devDependencies": {
    "@thunderid/eslint-plugin": "catalog:",
    "@thunderid/prettier-config": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
