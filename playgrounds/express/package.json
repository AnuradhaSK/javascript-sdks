{
  "name": "@thunderid/playground-express",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Playground for exercising every @thunderid/express capability, with an API explorer UI.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.ts,.cjs,.mjs",
    "lint:fix": "eslint . --fix --ext .js,.ts,.cjs,.mjs",
    "format:check": "prettier --check --cache .",
    "format:fix": "prettier --write --cache ."
  },
  "dependencies": {
    "@thunderid/express": "workspace:*",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@thunderid/eslint-plugin": "catalog:",
    "@thunderid/prettier-config": "catalog:",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.3",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
