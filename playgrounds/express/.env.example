# Copy to .env and fill in the values of the application you registered in ThunderID.

# ThunderID server.
THUNDERID_BASE_URL=https://localhost:8090

# OAuth2 client of the application. The client secret is required for a confidential client.
THUNDERID_CLIENT_ID=
THUNDERID_CLIENT_SECRET=

# Must match the redirect URIs registered for the application. They default to APP_URL/login and
# APP_URL/logout, which are the routes handleSignIn() and handleSignOut() are mounted on.
THUNDERID_AFTER_SIGN_IN_URL=http://localhost:3000/login
THUNDERID_AFTER_SIGN_OUT_URL=http://localhost:3000/logout

# Scopes to request, separated by spaces.
THUNDERID_SCOPES=openid profile email

# Only for POST /flow/sign-in (handleFlow()): the application ID, and the flow secret if the
# application requires one.
THUNDERID_APPLICATION_ID=
THUNDERID_FLOW_SECRET=

# Scope that GET /api/admin/users requires in the access token.
PLAYGROUND_ADMIN_SCOPE=system

# Where the playground listens.
PORT=3000
APP_URL=http://localhost:3000

# A local ThunderID server uses a self-signed certificate, which Node rejects. For local
# development only, turn certificate checks off:
# NODE_TLS_REJECT_UNAUTHORIZED=0
